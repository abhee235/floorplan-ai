# floorplan-ai configuration. Copy to .env (which git ignores) and fill in what you use.
# The host, tools/eval/run.ts and tools/score-raster.ts read the nearest .env walking up from where they run
# (or the file named by FPV_ENV_FILE). Variables already set in your shell win over this file; empty values
# are ignored. <data>/config.json still works and is read when a role is not configured here.

# ---- provider keys and addresses -----------------------------------------------------------------------------
# Only the providers you use need an entry. Keys never leave this machine except to that provider.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Local Ollama; change for another machine on your network.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# The context a model is loaded with belongs to the Ollama server, not to this app, and there is no way to ask for
# one over the OpenAI-compatible wire we speak: measured on Ollama 0.32, num_ctx is ignored at the top level and
# inside an options object alike, and unknown fields are accepted in silence, so nothing tells you it did nothing.
# Set it where it is actually read -- a PARAMETER num_ctx line in the model's own Modelfile, or on the server:
#   $env:OLLAMA_CONTEXT_LENGTH=32768; ollama serve
# or set OLLAMA_CONTEXT_LENGTH=32768 as a Windows user environment variable and restart the Ollama app.
# Recent Ollama versions size it themselves and are generous about it (131072 for gpt-oss:20b here), so check what
# you actually got -- `curl http://127.0.0.1:11434/api/ps` reports the loaded context -- before assuming it is small.
# A large context costs memory: the agent's prompt is around 12,000 tokens, and a window far beyond what a run needs
# is KV cache that could have held the model. The agent prints a warning when a server cuts the prompt.

# ---- the in-app agent (Space Designer) -------------------------------------------------------------------------
# Needs a model that calls tools. FPV_AGENT_PROVIDER is ollama, openai or openrouter; the model name is the
# provider's own name for it.
#   ollama:      qwen3.8:27b (installed here; tools and vision), qwen3.6:35b, qwen3.5:9b on smaller machines
#   openai:      a tool-calling chat model, e.g. gpt-4.1-mini (cheap) or gpt-4.1 (stronger). Newer models such as
#                gpt-5.6-luna work too: the app turns their reasoning off for tool calls on chat completions
#                (reasoning with tools needs OpenAI's Responses API, not wired yet). gpt-5.6-luna passed both
#                evaluation cards; see docs/eval/agent-runs.md.
#   openrouter:  "vendor/model" ids from openrouter.ai/models with tool support, e.g. openai/gpt-4.1-mini
# Measured results per model are in docs/eval/agent-runs.md.
FPV_AGENT_PROVIDER=ollama
FPV_AGENT_MODEL=qwen3.8:27b
# Which tools the model is shown: high (all), medium (all but modify_wall), low (semantic tools only).
FPV_AGENT_RELIABILITY=medium
# Optional: FPV_AGENT_BASE_URL, FPV_AGENT_API_KEY and FPV_AGENT_EXTRA_BODY (JSON) override the provider defaults;
# for Ollama the default extra body switches Qwen reasoning off ({"reasoning_effort":"none"}).
# How long one model call may take. A tool-calling turn on a local model takes minutes, and a big prompt on a
# reasoning model can take more than the five minutes this defaults to; a turn that runs out ends the whole run.
# FPV_AGENT_TIMEOUT_MS=300000
# A cap on what one reply may generate, honoured by every OpenAI-compatible server including Ollama. Unset means
# the server's own default, which for a reasoning model is "think for as long as you like" -- and a turn that
# outlasts the timeout above loses the run. Leave it generous: tool-call arguments are cut off mid-JSON by a cap
# that is too tight, which fails in a much more confusing way.
# FPV_AGENT_MAX_TOKENS=8000

# ---- the plan reader (images of floor plans) ------------------------------------------------------------------
# Needs a vision model. qwen3.8:27b found the most doors and windows in docs/eval/raster-reader.md; qwen3.6:35b
# is faster. With openai use a vision-capable model such as gpt-4.1-mini.
FPV_READER_PROVIDER=ollama
FPV_READER_MODEL=qwen3.8:27b
# FPV_READER_TIMEOUT_MS=600000

# ---- the product verifier (reads spec sheet pages) ------------------------------------------------------------
# Optional. Any model that answers in JSON; a web search provider is needed for it to find pages.
FPV_VERIFIER_PROVIDER=
FPV_VERIFIER_MODEL=
# FPV_SEARCH=brave            # or searxng
# FPV_SEARCH_API_KEY=         # Brave Search key
# FPV_SEARCH_URL=             # SearXNG base URL

# ---- evaluation ---------------------------------------------------------------------------------------------
# Models tools/eval/run.ts uses when --models is not given, e.g. ollama:qwen3.8:27b,openai:gpt-4.1-mini
FPV_EVAL_MODELS=ollama:qwen3.8:27b

# ---- host -------------------------------------------------------------------------------------------------------
# FPV_DATA_DIR=              # catalog database, libraries, transcripts (default: the platform data directory)
